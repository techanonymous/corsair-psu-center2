// ---- daily energy bar chart (from the 2026.11.11a fork build) ----
// ---- history charts: power draw (line) + daily energy (bars) ----
const MON  = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const MONL = ['January','February','March','April','May','June','July','August','September','October','November','December'];
const DOW  = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
const pad2 = n => String(n).padStart(2,'0');

// Size the SVG's coordinate system to its real pixel box so text never stretches.
function chartBox(svg){
  const r  = svg.getBoundingClientRect();
  const w  = Math.max(240, Math.round(r.width  || 600));
  const h  = Math.max(120, Math.round(r.height || 220));
  const fs = Math.max(9, Math.round(parseFloat(getComputedStyle(document.getElementById('cpc')).fontSize) * 0.72));
  svg.setAttribute('viewBox', `0 0 ${w} ${h}`);
  return {w, h, fs, X0: Math.round(fs*4.2), X1: w-8, Y0: h-fs-10, Y1: 8};
}
function niceStep(raw){
  if (!(raw > 0)) return 1;
  const p = Math.pow(10, Math.floor(Math.log10(raw))), m = raw / p;
  return (m<=1 ? 1 : m<=2 ? 2 : m<=2.5 ? 2.5 : m<=5 ? 5 : 10) * p;
}
function yScale(lo, hi){
  if (hi - lo < 1e-9) { hi = lo + 1; }
  const step = niceStep((hi - lo) / 4);
  const y0 = Math.max(0, Math.floor(lo / step) * step);
  let   y1 = Math.ceil(hi / step) * step; if (y1 <= y0) y1 = y0 + step;
  return {y0, y1, step};
}
function numFmt(v){
  const a = Math.abs(v);
  return a >= 100 ? v.toFixed(0) : a >= 10 ? String(+v.toFixed(1)) : String(+v.toFixed(2));
}
// x-axis label, kept inside the plot: one that would spill past either edge is
// anchored to that edge instead of centred (no clipping, no clash with y labels).
function xLabel(b, x, text){
  const half = text.length * b.fs * 0.3;
  let anchor = 'middle';
  if (x - half < b.X0) { x = b.X0; anchor = 'start'; }
  else if (x + half > b.X1) { x = b.X1; anchor = 'end'; }
  return `<text x="${(+x).toFixed(1)}" y="${b.Y0 + b.fs + 4}" fill="#6c727b" font-size="${b.fs}" text-anchor="${anchor}">${text}</text>`;
}
function yAxis(b, ys, ty, unit){
  let h = '';
  for (let v = ys.y0; v <= ys.y1 + ys.step/1000; v += ys.step){
    const y = ty(v).toFixed(1);
    h += `<line x1="${b.X0}" y1="${y}" x2="${b.X1}" y2="${y}" stroke="#262b33"/>`;
    h += `<text x="${b.X0-6}" y="${(+y + b.fs*0.35).toFixed(1)}" fill="#6c727b" font-size="${b.fs}" text-anchor="end">${numFmt(v)}${unit}</text>`;
  }
  return h;
}
// Time-axis ticks on local-time boundaries (hours, midnights, month starts).
const TSTEPS = [300,600,900,1800,3600,7200,10800,21600,43200,86400,172800,604800,1209600,2592000,7776000];
function timeTicks(from, to, maxN){
  const span = to - from;
  let st = TSTEPS[TSTEPS.length-1];
  for (const s of TSTEPS) if (span / s <= maxN) { st = s; break; }
  const out = [];
  if (st >= 2592000){
    const d = new Date(from*1000); d.setDate(1); d.setHours(0,0,0,0);
    while (d.getTime()/1000 < from) d.setMonth(d.getMonth()+1);
    for (; d.getTime()/1000 <= to; d.setMonth(d.getMonth() + st/2592000)) out.push(d.getTime()/1000);
  } else if (st >= 86400){
    const d = new Date(from*1000); d.setHours(0,0,0,0);
    while (d.getTime()/1000 < from) d.setDate(d.getDate()+1);
    for (; d.getTime()/1000 <= to; d.setDate(d.getDate() + st/86400)) out.push(d.getTime()/1000);
  } else {
    const tzo = new Date(to*1000).getTimezoneOffset() * 60;      // seconds; negative east of UTC
    for (let t = Math.ceil((from - tzo)/st)*st + tzo; t <= to; t += st) out.push(t);
  }
  return {ticks: out, mode: st < 86400 ? 'hm' : (st < 2592000 ? 'dm' : 'my')};
}
function tickLabel(ts, mode){
  const d = new Date(ts*1000);
  if (mode === 'hm') return pad2(d.getHours()) + ':' + pad2(d.getMinutes());
  if (mode === 'dm') return d.getDate() + ' ' + MON[d.getMonth()];
  return MON[d.getMonth()] + " '" + String(d.getFullYear()).slice(2);
}
function whenLabel(ts, step){
  const d = new Date(ts*1000), day = DOW[d.getDay()] + ' ' + d.getDate() + ' ' + MON[d.getMonth()];
  if (step >= 86400) return day + ' ' + d.getFullYear();
  if (step >= 3600)  return day + ', ' + pad2(d.getHours()) + ':00–' + pad2((d.getHours()+1)%24) + ':00';
  return day + ', ' + pad2(d.getHours()) + ':' + pad2(d.getMinutes());
}

// --- power draw ---
// --- daily energy ---
const D_RANGES = ['30','90','m12'];
let dRange = '30', dDays = [], dHover = null, dBars = [];
try { const sd = localStorage.getItem('cpc2DailyRange'); if (sd && D_RANGES.includes(sd)) dRange = sd; } catch(e) {}
function dailyData(){
  const out = [], now = new Date();
  if (dRange === 'm12'){
    for (let i = 11; i >= 0; i--){
      const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
      const ym = d.getFullYear() + '-' + pad2(d.getMonth()+1), m = histMonths.find(x=>x.ym===ym);
      out.push({label: MON[d.getMonth()] + (d.getMonth()===0 ? " '"+String(d.getFullYear()).slice(2) : ''),
                full: MONL[d.getMonth()] + ' ' + d.getFullYear(), kwh: m ? m.kwh : 0, cost: m ? m.cost : null,
                has: !!m, partial: i === 0});
    }
    return out;
  }
  const n = parseInt(dRange, 10) || 30, map = {};
  dDays.forEach(x=>{ map[x.date] = x; });
  now.setHours(12,0,0,0);
  for (let i = n - 1; i >= 0; i--){
    const d = new Date(now); d.setDate(now.getDate() - i);
    const key = d.getFullYear() + '-' + pad2(d.getMonth()+1) + '-' + pad2(d.getDate()), r = map[key];
    out.push({label: d.getDate() + ' ' + MON[d.getMonth()], full: DOW[d.getDay()] + ' ' + d.getDate() + ' ' + MON[d.getMonth()] + ' ' + d.getFullYear(),
              kwh: r ? r.kwh : 0, cost: r ? r.cost : null, has: !!r, partial: i === 0});
  }
  return out;
}
function costOf(row){ return row.cost !== null && row.cost !== undefined ? row.cost : row.kwh * lastRate; }
function dailyReadDefault(){
  const el = document.getElementById('dailyRead'), rows = dBars.filter(r=>r.has);
  if (!rows.length){ el.innerHTML = '&nbsp;'; return; }
  const tot = rows.reduce((a,r)=>a + r.kwh, 0), cost = rows.reduce((a,r)=>a + costOf(r), 0);
  const full = rows.filter(r=>!r.partial), unit = dRange === 'm12' ? 'month' : 'day';
  const avg = full.length ? full.reduce((a,r)=>a + r.kwh, 0) / full.length : null;
  el.innerHTML = `Total <span class="k">${kwhFmt(tot)} kWh</span>` + (lastRate > 0 ? ` <span class="c">${money(cost)}</span>` : '') +
    (avg !== null ? ` &nbsp;·&nbsp; average <b>${kwhFmt(avg)} kWh</b> per ${unit}` + (lastRate > 0 ? ` (<span class="c">${money(avg*lastRate)}</span>)` : '') : '');
}
function setDailyHover(i){
  dHover = i;
  const svg = document.getElementById('dailySvg');
  svg.querySelectorAll('rect.bar').forEach(r=>r.setAttribute('fill-opacity', (i === null || +r.dataset.i === i) ? r.dataset.op : '0.35'));
  if (i === null || !dBars[i]){ dailyReadDefault(); return; }
  const r = dBars[i];
  document.getElementById('dailyRead').innerHTML = !r.has ? `${r.full} &nbsp;—&nbsp; no data`
    : `${r.full}${r.partial ? ' (so far)' : ''} &nbsp;—&nbsp; <span class="k">${kwhFmt(r.kwh)} kWh</span>` + (lastRate > 0 ? ` <span class="c">${money(costOf(r))}</span>` : '');
}
/* How much of the daily record exists: what these three buttons can be
   filled from. dDays comes oldest-first from the API. */
function dailyRecord(){
  if (!dDays.length) return null;
  const a = new Date(dDays[0].date + 'T12:00:00'), z = new Date(dDays[dDays.length-1].date + 'T12:00:00');
  return {days: Math.round((z-a)/864e5) + 1,
          months: new Set(dDays.map(x=>x.date.slice(0,7))).size,
          since: dDays[0].date, until: dDays[dDays.length-1].date};
}
function dailyButtons(){
  const rec = dailyRecord();
  document.querySelectorAll('#dailyRange .cpc-btn').forEach(b=>{
    const on = b.dataset.r === dRange;
    b.classList.toggle('active', on);
    b.setAttribute('aria-pressed', on ? 'true' : 'false');
    b.classList.remove('cpc-short', 'cpc-none'); b.removeAttribute('title');
    if (!rec) return;
    const byMonth = b.dataset.r === 'm12';
    const have = byMonth ? rec.months : rec.days, need = byMonth ? 12 : parseInt(b.dataset.r, 10);
    if (have >= need) return;
    b.classList.add('cpc-short');
    if (!have) b.classList.add('cpc-none');
    b.title = 'Only ' + have + ' ' + (byMonth ? 'month' : 'day') + (have === 1 ? '' : 's') + ' of energy recorded so far ('
            + rec.since + ' onwards), so this cannot be ' + (byMonth ? '12 months' : need + ' days') + ' long yet.';
  });
}
function dailyWindow(){
  const el = document.getElementById('dailyWindow'); if (!el) return;
  const withData = dBars.filter(r=>r.has);
  const spanTxt = dRange === 'm12' ? 'Last 12 months' : 'Last ' + dRange + ' days';
  if (!withData.length){ el.innerHTML = '<span class="warn">' + spanTxt + ' — no energy recorded in this range yet.</span>'; return; }
  const txt = r => dRange === 'm12' ? r.full : r.label;
  let h = spanTxt + ': showing <span class="k">' + txt(withData[0]) + ' &rarr; ' + txt(withData[withData.length-1]) + '</span>'
        + ' &nbsp;·&nbsp; <b>' + withData.length + '</b> of ' + dBars.length + (dRange === 'm12' ? ' months' : ' days') + ' with data';
  if (withData.length < dBars.length)
    h += ' &nbsp;·&nbsp; <span class="warn">energy record starts ' + (lastSince ? fmtDay(lastSince) : txt(withData[0])) + '</span>';
  el.innerHTML = h;
}
function drawDaily(){
  const svg = document.getElementById('dailySvg'); if (!svg) return;
  dailyButtons();
  dBars = dailyData();
  dailyWindow();
  const b = chartBox(svg), n = dBars.length;
  if (!dBars.some(r=>r.has)){
    svg.innerHTML = `<text x="${(b.X0+b.X1)/2}" y="${(b.Y0+b.Y1)/2}" fill="#7c828b" font-size="${b.fs+1}" text-anchor="middle">No energy recorded in this range yet.</text>`;
    svg.onpointermove = svg.onpointerleave = null; dailyReadDefault(); return;
  }
  const ys = yScale(0, Math.max(...dBars.map(r=>r.kwh)) * 1.05);
  const ty = v => b.Y0 - (v - ys.y0) / (ys.y1 - ys.y0) * (b.Y0 - b.Y1);
  const slot = (b.X1 - b.X0) / n, bw = Math.max(1, slot * (n > 60 ? 0.8 : 0.7));
  let h = `<rect x="${b.X0}" y="${b.Y1}" width="${b.X1-b.X0}" height="${b.Y0-b.Y1}" fill="#14161a"/>`;
  h += yAxis(b, ys, ty, '');
  h += `<text x="${b.X0+4}" y="${b.Y1 + b.fs}" fill="#6c727b" font-size="${b.fs}">kWh</text>`;
  const every = Math.max(1, Math.ceil(n / Math.max(2, Math.floor((b.X1-b.X0) / (b.fs*5.5)))));
  dBars.forEach((r,i)=>{
    const x = b.X0 + slot*i + (slot - bw)/2;
    if (r.has && r.kwh > 0){
      const y = ty(r.kwh), op = r.partial ? '0.5' : '1';
      h += `<rect class="bar" data-i="${i}" data-op="${op}" x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${bw.toFixed(1)}" height="${(b.Y0-y).toFixed(1)}" rx="1" fill="#f0c040" fill-opacity="${op}"/>`;
    }
    if ((n - 1 - i) % every === 0)
      h += xLabel(b, b.X0 + slot*i + slot/2, r.label);
  });
  svg.innerHTML = h;
  svg.onpointermove = e=>{
    const rc = svg.getBoundingClientRect();
    const i = Math.floor(((e.clientX - rc.left) * b.w / rc.width - b.X0) / slot);
    if (i >= 0 && i < n && i !== dHover) setDailyHover(i);
  };
  svg.onpointerleave = ()=> setDailyHover(null);
  setDailyHover(dHover !== null && dHover < n ? dHover : null);
}
document.querySelectorAll('#dailyRange .cpc-btn').forEach(btn=>{
  btn.onclick = ()=>{
    dRange = btn.dataset.r; dHover = null;
    try { localStorage.setItem('cpc2DailyRange', dRange); } catch(e) {}
    drawDaily();
  };
});

