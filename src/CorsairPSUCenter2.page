// ---- v2: power history chart ----
// Power, Breakdown, Temperature and Fans are independent on/off layers on ONE
// chart, so you can line up e.g. power draw against fan speed. Watts use the
// left axis, °C the first right axis, RPM the outer right axis; an axis is only
// drawn while one of its layers is on.
/* ---- "what am I looking at?" helpers -------------------------------
   A range button only records what was asked for. Whenever the record is
   shorter than that - fresh install, or a tier that rolled over - 24h, 7d and
   30d draw the very same short window, so each range control also spells out
   the span actually on screen. Times are drawn in the browser's zone, which is
   not always the server's, so that gets named too. */
function fmtDur(s){
  s = Math.max(0, Math.round(s));
  const d = Math.floor(s/86400), h = Math.floor(s%86400/3600), m = Math.floor(s%3600/60);
  if (!d) return h ? h + 'h ' + String(m).padStart(2,'0') + 'm' : (m ? m + 'm' : s + 's');
  if (d >= 60 || !h) return d + 'd';
  return d + 'd ' + String(h).padStart(2,'0') + 'h';
}
function fmtDay(ts){ const d = new Date(ts*1000); return d.getDate() + ' ' + MON[d.getMonth()]; }
function fmtClock(ts){ const d = new Date(ts*1000); return String(d.getHours()).padStart(2,'0') + ':' + String(d.getMinutes()).padStart(2,'0'); }
function fmtStamp(ts){ return fmtDay(ts) + ' ' + fmtClock(ts); }
function tzLabel(){
  const off = -new Date().getTimezoneOffset(), a = Math.abs(off);
  return 'UTC' + (off < 0 ? '-' : '+') + Math.floor(a/60) + (a % 60 ? ':' + String(a % 60).padStart(2,'0') : '');
}
const PH_RANGES = ['1h','6h','12h','24h','7d','30d','365d'];
let phRange = '24h', phData = null, phMeta = null;
let phOn = {power:true, breakdown:false, temp:false, fans:false};
try {
  // Only accept a stored value we still offer. Anything else (a rename, a
  // hand-edited key) used to leave every range button unhighlighted while the
  // chart carried on with the fallback range.
  const sr = localStorage.getItem('cpc2Range');
  if (sr && PH_RANGES.includes(sr)) phRange = sr;
  const sv = JSON.parse(localStorage.getItem('cpc2Layers') || 'null');
  if (sv && typeof sv === 'object') for (const k in phOn) phOn[k] = !!sv[k];
} catch(e){}
const C = {pin:'#b98ee6', pout:'#f0c040', cpu:'#6fa8dc', gpu:'#6fc26f', drv:'#e0904a', other:'#7a8089', loss:'#d05353',
           vrm:'#ff7a45', vrmx:'#ffb38a', case:'#ffd166', fan:'#4dd0c8', sfan:'#f48fb1'};
// row columns from api: ts pout pout_max pin vrm vrm_max case fan cpu gpu drv sfan nfan
const I = {ts:0, pout:1, poutx:2, pin:3, vrm:4, vrmx:5, case:6, fan:7, cpu:8, gpu:9, drv:10, sfan:11, nfan:12};
const v = (r,k) => (r[I[k]]===undefined ? null : r[I[k]]);
const AX = {W:{unit:'W'}, C:{unit:'°C'}, R:{unit:'RPM'}};

/* Every visible series: {key,label,color,axis,val(r),stack,dash,area,extra(r)}. */
function phSeries(rows){
  const out = [], has = k => rows.some(r=>v(r,k)!==null);
  if (phOn.breakdown) {
    const known = r => (v(r,'cpu')||0)+(v(r,'gpu')||0)+(v(r,'drv')||0);
    if (has('cpu')) out.push({key:'cpu', label:'CPU', color:C.cpu, axis:'W', stack:true, val:r=>v(r,'cpu')});
    if (has('gpu')) out.push({key:'gpu', label:'GPU', color:C.gpu, axis:'W', stack:true, val:r=>v(r,'gpu')});
    if (has('drv')) out.push({key:'drv', label:'Drives (estimated)', color:C.drv, axis:'W', stack:true, val:r=>v(r,'drv')});
    out.push({key:'other', label:'Everything else', color:C.other, axis:'W', stack:true, val:r=> v(r,'pout')===null?null:Math.max(0, v(r,'pout')-known(r))});
    if (has('pin')) out.push({key:'loss', label:'PSU losses', color:C.loss, axis:'W', stack:true, val:r=> (v(r,'pin')===null||v(r,'pout')===null)?null:Math.max(0, v(r,'pin')-v(r,'pout'))});
  }
  if (phOn.power) {
    out.push({key:'pin',  label:'Power in (wall, estimated)', color:C.pin,  axis:'W', area:!phOn.breakdown, val:r=>v(r,'pin')});
    out.push({key:'pout', label:'Power out (DC)',             color:C.pout, axis:'W', val:r=>v(r,'pout')});
  }
  if (phOn.temp) {
    out.push({key:'vrm',  label:'VRM temp',  color:C.vrm,  axis:'C', dash:'6 3', val:r=>v(r,'vrm')});
    out.push({key:'case', label:'Case temp', color:C.case, axis:'C', dash:'6 3', val:r=>v(r,'case')});
  }
  if (phOn.fans) {
    out.push({key:'fan',  label:'PSU fan', color:C.fan, axis:'R', dash:'2 3', val:r=>v(r,'fan')});
    if (has('sfan')) out.push({key:'sfan', label:'System fans (avg)', color:C.sfan, axis:'R', dash:'2 3', val:r=>v(r,'sfan'),
      extra:r=> v(r,'nfan')!==null ? ' across '+v(r,'nfan')+' spinning fan'+(v(r,'nfan')==1?'':'s') : ''});
  }
  return out;
}

function fmtTick(ts){
  const d = new Date(ts*1000);
  if (['1h','6h','12h','24h'].includes(phRange)) return d.toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'});
  if (phRange==='365d') return d.toLocaleDateString([], {month:'short', year:'2-digit'});
  return d.toLocaleDateString([], {month:'short', day:'numeric'});
}
function fmtTip(ts){
  const d = new Date(ts*1000);
  if (phRange==='365d') return d.toLocaleDateString([], {weekday:'short', day:'numeric', month:'short', year:'numeric'});
  return d.toLocaleString([], {weekday:'short', day:'numeric', month:'short', hour:'2-digit', minute:'2-digit'});
}
function niceMax(x){ if (!(x>0)) return 1; const p=Math.pow(10, Math.floor(Math.log10(x))); for (const m of [1,1.5,2,2.5,3,4,5,6,8,10]) if (m*p>=x) return m*p; return 10*p; }
function axFmt(y, unit){ return unit==='°C' ? Math.round(y) : (y>=1000 ? (y/1000).toFixed(y%1000?1:0)+'k' : Math.round(y)); }
function valFmt(x, unit){ return unit==='RPM' ? Math.round(x).toLocaleString() : Number(x).toFixed(1); }

/* Spell out the window actually drawn, taken from the rows that came back, and
   say so when the record cannot cover the requested span. */
function phWindow(){
  const el = q('phWindow'); if (!el) return;
  const rows = phData && phData.rows ? phData.rows : [];
  const asked = phData ? phData.range : phRange;
  if (!rows.length){
    el.innerHTML = '<span class="warn">No samples in the last ' + asked + ' yet — nothing stored for this window.</span>';
    return;
  }
  const first = rows[0][0], last = rows[rows.length-1][0];
  const shown = rows.length > 1 ? fmtDur(last-first) : 'a single ' + phData.step + 's bucket';
  const oneDay = new Date(first*1000).toDateString() === new Date(last*1000).toDateString();
  let h = 'Showing <span class="k">' + fmtStamp(first) + ' &rarr; ' + (oneDay ? fmtClock(last) : fmtStamp(last)) + '</span>'
        + ' <span class="tz">(' + tzLabel() + ')</span> &nbsp;·&nbsp; <b>' + shown + '</b>'
        + ' &nbsp;·&nbsp; ' + rows.length + ' points at ' + phData.step + 's';
  if (phData.since && first > phData.from + phData.step)
    h += ' &nbsp;·&nbsp; <span class="warn">not a full ' + asked + ' — the record starts ' + fmtDay(phData.since) + '</span>';
  el.innerHTML = h;
}
function drawHist(){
  phWindow();
  const svg = q('histSvg'); if (!svg || !phData) return;
  const W = Math.max(300, svg.clientWidth), H = Math.max(160, svg.clientHeight);
  svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
  const rows = phData.rows || [], step = phData.step, from = phData.from, to = phData.to;
  const ser = phSeries(rows);
  const used = {W:ser.some(s=>s.axis==='W'), C:ser.some(s=>s.axis==='C'), R:ser.some(s=>s.axis==='R')};
  const L = used.W ? 50 : 14, T = 10, B = H - 24;
  const R = W - 12 - (used.C ? 38 : 0) - (used.R ? 46 : 0);
  const X = ts => L + (ts - from) / Math.max(1, to - from) * (R - L);

  // stacked layers accumulate; everything else is plotted as-is
  const vals = rows.map(r=>{ let acc = 0; return ser.map(s=>{ const x = s.val(r); if (!s.stack) return x; if (x===null) return null; acc += x; return acc; }); });
  const max = {W:0, C:0, R:0};
  vals.forEach(a=>a.forEach((x,si)=>{ if (x!==null && x>max[ser[si].axis]) max[ser[si].axis] = x; }));
  const top = {W:niceMax(max.W*1.05), C:niceMax(Math.max(40, max.C*1.1)), R:niceMax(max.R*1.08)};
  const Y = (y, ax) => B - (y/top[ax])*(B-T);

  let h = `<rect x="${L}" y="${T}" width="${R-L}" height="${B-T}" fill="#14161a"/>`;
  const gridAx = used.W ? 'W' : (used.C ? 'C' : 'R');
  for (let i=0;i<=4;i++) h += `<line x1="${L}" y1="${Y(top[gridAx]*i/4, gridAx)}" x2="${R}" y2="${Y(top[gridAx]*i/4, gridAx)}" stroke="#262b33"/>`;
  // axis labels: W on the left, °C then RPM on the right, tinted like their layers
  const axCol = {W:'#6c727b', C:C.vrm, R:C.fan};
  const axX = {W:L-6, C:R+6, R:R+6+(used.C?38:0)};
  ['W','C','R'].forEach(ax=>{
    if (!used[ax]) return;
    const anchor = ax==='W' ? 'end' : 'start';
    for (let i=0;i<=4;i++){
      const y = top[ax]*i/4;
      h += `<text x="${axX[ax]}" y="${Y(y,ax)+4}" fill="${axCol[ax]}" fill-opacity="${ax==='W'?1:.85}" font-size="11" text-anchor="${anchor}">${axFmt(y, AX[ax].unit)}</text>`;
    }
  });
  const nt = Math.max(2, Math.min(8, Math.floor((R-L)/110)));
  let lastLbl = '';
  for (let i=0;i<=nt;i++){
    const ts = from + (to-from)*i/nt, x = X(ts), lbl = fmtTick(ts);
    h += `<line x1="${x}" y1="${T}" x2="${x}" y2="${B}" stroke="#1f232a"/>`;
    if (lbl === lastLbl) continue;
    lastLbl = lbl;
    h += `<text x="${x}" y="${B+16}" fill="#6c727b" font-size="11" text-anchor="${i==0?'start':(i==nt?'end':'middle')}">${lbl}</text>`;
  }
  // split into runs wherever buckets are missing (server off, PSU gone)
  const runs = []; let cur = [];
  rows.forEach((r,i)=>{ if (cur.length && r[0]-rows[cur[cur.length-1]][0] > step*2.5){ runs.push(cur); cur=[]; } cur.push(i); });
  if (cur.length) runs.push(cur);
  const xOf = i => X(rows[i][0] + (step>=86400 ? 0 : step/2));
  const P = p => p[0].toFixed(1)+','+p[1].toFixed(1);
  // draw stacked areas first, then lines on top (W lines, then °C, then RPM)
  const order = ser.map((s,i)=>i).sort((a,b)=> (ser[b].stack?1:0)-(ser[a].stack?1:0) || 'WCR'.indexOf(ser[a].axis)-'WCR'.indexOf(ser[b].axis));
  order.forEach(si=>{
    const s = ser[si];
    runs.forEach(run=>{
      const idx = run.filter(i=>vals[i][si]!==null);
      if (!idx.length) return;
      const pts = idx.map(i=>[xOf(i), Y(vals[i][si], s.axis)]);
      const line = pts.map(P).join(' ');
      if (s.stack){
        const base = idx.map(i=>{
          let b = 0; for (let k=si-1;k>=0;k--) if (ser[k].stack && vals[i][k]!==null){ b = vals[i][k]; break; }
          return [xOf(i), Y(b, 'W')];
        }).reverse().map(P).join(' ');
        h += `<polygon points="${line} ${base}" fill="${s.color}" fill-opacity="${phOn.temp||phOn.fans ? .4 : .55}" stroke="none"/>`;
        h += `<polyline points="${line}" fill="none" stroke="${s.color}" stroke-width="1.1"/>`;
      } else {
        if (s.area) h += `<polygon points="${pts[0][0].toFixed(1)},${B} ${line} ${pts[pts.length-1][0].toFixed(1)},${B}" fill="${s.color}" fill-opacity=".12"/>`;
        if (pts.length===1) h += `<circle cx="${pts[0][0]}" cy="${pts[0][1]}" r="2.5" fill="${s.color}"/>`;
        h += `<polyline points="${line}" fill="none" stroke="${s.color}" stroke-width="1.8"${s.dash?` stroke-dasharray="${s.dash}"`:''}/>`;
      }
    });
  });
  const msgTxt = !ser.length ? 'Turn on Power, Breakdown, Temperature or Fans above.'
               : (!rows.length ? 'No data for this range yet - it fills in as the collector runs.' : '');
  if (msgTxt) h += `<text x="${(L+R)/2}" y="${(T+B)/2}" fill="#7c828b" font-size="13" text-anchor="middle">${msgTxt}</text>`;
  // unit captions inside the plot corners
  if (used.W) h += `<text x="${L+6}" y="${T+14}" fill="#8a9099" font-size="11">W</text>`;
  const rc = [used.C?'°C':'', used.R?'RPM':''].filter(Boolean).join(' · ');
  if (rc) h += `<text x="${R-6}" y="${T+14}" fill="#8a9099" font-size="11" text-anchor="end">${rc}</text>`;
  h += `<line id="phCursor" x1="0" y1="${T}" x2="0" y2="${B}" stroke="#e8eaed55" visibility="hidden"/>`;
  svg.innerHTML = h;

  const axName = {W:'', C:' (°C, right)', R:' (RPM, right)'};
  q('phLegend').innerHTML = ser.map(s=>{
    const sw = s.dash ? `<span class="sw" style="background:none;border-top:2px dashed ${s.color};height:0;width:1.1em;vertical-align:.25em"></span>`
                      : `<span class="sw" style="background:${s.color}"></span>`;
    return `<span>${sw}${s.label}${(used.C||used.R)?axName[s.axis]:''}</span>`;
  }).join('');

  // hover tooltip: every visible value at the nearest bucket, grouped by axis
  const tip = q('phTip');
  svg.onmousemove = e=>{
    if (!rows.length || !ser.length) return;
    const rc = svg.getBoundingClientRect(), mx = (e.clientX-rc.left) * W / rc.width;
    let best = 0, bd = 1e9;
    rows.forEach((r,i)=>{ const d = Math.abs(xOf(i)-mx); if (d<bd){ bd=d; best=i; } });
    const r = rows[best], cx = xOf(best);
    const cl = q('phCursor'); cl.setAttribute('x1',cx); cl.setAttribute('x2',cx); cl.setAttribute('visibility','visible');
    let t = `<div style="color:#9aa0a8;margin-bottom:.15em">${fmtTip(r[0])}</div>`;
    ['W','C','R'].forEach((ax, n)=>{
      const group = ser.filter(s=>s.axis===ax);
      if (!group.length) return;
      if (n && t.indexOf('<b>')>=0) t += `<div style="height:.3em"></div>`;
      (ax==='W' ? group.slice().reverse() : group).forEach(s=>{
        const x = s.val(r); if (x===null) return;
        t += `<div><span class="sw" style="background:${s.color}"></span>${s.label}: <b>${valFmt(x, AX[ax].unit)} ${AX[ax].unit}</b>${s.extra?s.extra(r):''}</div>`;
      });
      if (ax==='W' && phOn.breakdown && !phOn.power && v(r,'pin')!==null)
        t += `<div style="margin-top:.15em;color:#9aa0a8">Total at the wall: <b style="color:#e8eaed">${Number(v(r,'pin')).toFixed(1)} W</b></div>`;
    });
    tip.innerHTML = t; tip.style.display = 'block';
    const px = cx / W * rc.width, tw = tip.offsetWidth;
    tip.style.left = Math.max(0, Math.min(rc.width - tw, px + 14 > rc.width - tw ? px - tw - 14 : px + 14)) + 'px';
    tip.style.top = '0.4em';
  };
  svg.onmouseleave = ()=>{ tip.style.display='none'; const cl=q('phCursor'); if (cl) cl.setAttribute('visibility','hidden'); };

  // summary line for the layers that are on
  const st = phData.stats || {}, f0 = x => x===null||x===undefined ? '--' : Math.round(x).toLocaleString();
  const parts = [];
  if (phOn.power || phOn.breakdown) {
    let p = '';
    if (st.pin)  p += `Wall <b>${f0(st.pin.avg)} W</b> avg · <b>${f0(st.pin.max)} W</b> max`;
    if (st.pout) p += `${p?' &nbsp; ':''}Output <b>${f0(st.pout.avg)} W</b> avg · <b>${f0(st.pout.max)} W</b> peak`;
    if (phData.kwh!==null && phData.kwh!==undefined) p += ` &nbsp; Used <b>${kwhFmt(phData.kwh)} kWh</b>` + (lastRate>0 ? ` (<b>${money(phData.kwh*lastRate)}</b>)` : '');
    if (p) parts.push(p);
  }
  if (phOn.breakdown) {
    const b = [];
    if (st.cpu) b.push(`CPU <b>${f0(st.cpu.avg)} W</b>`); if (st.gpu) b.push(`GPU <b>${f0(st.gpu.avg)} W</b>`); if (st.drv) b.push(`Drives ~<b>${f0(st.drv.avg)} W</b>`);
    if (b.length) parts.push(b.join(' · ') + ' avg');
  }
  if (phOn.temp && st.vrm) parts.push(`VRM <b>${st.vrm.avg.toFixed(1)}°C</b> avg · <b>${st.vrm.max.toFixed(1)}°C</b> peak` + (st.case ? ` · Case <b>${st.case.avg.toFixed(1)}°C</b> avg` : ''));
  if (phOn.fans) {
    const f = [];
    if (st.fan)  f.push(`PSU fan <b>${f0(st.fan.avg)} RPM</b>`);
    if (st.sfan) f.push(`System fans <b>${f0(st.sfan.avg)} RPM</b>`);
    if (f.length) parts.push(f.join(' · ') + ' avg');
  }
  q('phStats').innerHTML = parts.join(' &nbsp;&nbsp; ');
  const notes = [];
  if (phOn.power) notes.push('The PSU doesn\'t report wall power, so it\'s estimated from output power using the model\'s efficiency curve.');
  if (phOn.breakdown) notes.push('Breakdown: CPU comes from the processor\'s own power counters (RAPL) and GPU from the graphics driver. Drives are estimated from how many are spun down, idle or busy, as disks have no power sensor. "Everything else" is the rest of the PSU output (motherboard, RAM, fans, CPU power-stage losses). PSU losses are the gap between wall and output. Together they add up to the wall draw.');
  if (phOn.temp || phOn.fans) notes.push('Temperature (°C) and fan speed (RPM) use their own scales on the right, drawn as dashed and dotted lines.');
  q('phNote').textContent = notes.join(' ');
}

function loadHist(){
  fetch(API+'?action=history&range='+encodeURIComponent(phRange)).then(r=>r.json()).then(d=>{
    phData = d;
    phMeta = {since: d.since || null, spans: d.spans || null, to: d.to || Math.floor(Date.now()/1000)};
    phButtons(); drawHist();
  }).catch(()=>{});
}
/* Active = the selected range. A range longer than the whole record is marked,
   not hidden: clicking it still shows everything there is, it just cannot span
   that far back yet. */
function phButtons(){
  document.querySelectorAll('#phRange [data-r]').forEach(b=>{
    const on = b.dataset.r === phRange;
    b.classList.toggle('active', on);
    b.setAttribute('aria-pressed', on ? 'true' : 'false');
    b.classList.remove('cpc-short', 'cpc-none'); b.removeAttribute('title');
    const span = phMeta && phMeta.spans ? phMeta.spans[b.dataset.r] : null;
    if (!phMeta || !phMeta.since || !span) return;
    const have = phMeta.to - phMeta.since;
    if (have >= span * 0.98) return;
    b.classList.add('cpc-short');
    if (have < 120) b.classList.add('cpc-none');
    b.title = 'The record covers ' + fmtDur(have) + ' so far (starts ' + fmtDay(phMeta.since)
            + '), so this cannot span ' + b.textContent + ' yet — it shows everything there is.';
  });
  document.querySelectorAll('#phRange [data-v]').forEach(b=>{ b.classList.toggle('active', !!phOn[b.dataset.v]); b.setAttribute('aria-pressed', phOn[b.dataset.v]?'true':'false'); });
}
document.querySelectorAll('#phRange [data-r]').forEach(b=>b.onclick = ()=>{
  phRange = b.dataset.r; try { localStorage.setItem('cpc2Range', phRange); } catch(e){}
  phButtons(); loadHist();
});
document.querySelectorAll('#phRange [data-v]').forEach(b=>b.onclick = ()=>{
  phOn[b.dataset.v] = !phOn[b.dataset.v];
  try { localStorage.setItem('cpc2Layers', JSON.stringify(phOn)); } catch(e){}
  phButtons(); drawHist();
});
window.addEventListener('resize', ()=>{ clearTimeout(window._cpcRs); window._cpcRs = setTimeout(()=>{ drawHist(); drawDaily(); }, 150); });
phButtons(); loadHist();
setInterval(()=>{ if (!document.hidden) loadHist(); }, 15000);

// ---- text size (persisted per browser) ----
const app = document.getElementById('cpc');
let scale = parseFloat(localStorage.getItem('cpc2Scale') || '1');
function applyScale(){
  scale = Math.max(0.8, Math.min(2.0, Math.round(scale*100)/100));
  app.style.setProperty('--cpc-scale', scale);
  localStorage.setItem('cpc2Scale', scale);
  if (typeof drawHist === 'function') { drawHist(); drawDaily(); }   // chart text follows the app font
}
document.getElementById('zIn').onclick  = ()=>{ scale += 0.1; applyScale(); };
document.getElementById('zOut').onclick = ()=>{ scale -= 0.1; applyScale(); };
document.getElementById('zRst').onclick = ()=>{ scale = 1;    applyScale(); };
applyScale();

refresh();
setInterval(refresh, 2000);
refreshEnergy();
setInterval(refreshEnergy, 10000);
})();
</script>
